class_name Backdrop
extends Node2D
## The parallax background behind a room: a far layer and a mid layer per zone
## (generated by tools/art/tilegen.py into assets/bg/), scrolling slower than
## the camera and repeating sideways.

const DIR := "res://assets/bg/"
const PAINTED_DIR := "res://assets/painted/"
## Layer suffix -> scroll speed relative to the camera.
const LAYERS := {"far": Vector2(0.15, 0.1), "mid": Vector2(0.4, 0.3)}
const SIZE := Vector2(640, 480)
## Starts the layers a little above the room's top so vertical scrolling never shows a gap.
const OFFSET := Vector2(0, -60)

var zone := ""
## Painterly scenery test: layers from assets/painted/ instead (see Room._apply_plate).
var painted := false


func _ready() -> void:
	z_index = -50


func set_zone(next: String, paint := false) -> void:
	if next == zone and paint == painted:
		return
	zone = next
	painted = paint
	for c in get_children():
		c.queue_free()
	for suffix: String in LAYERS:
		var path := (PAINTED_DIR if painted else DIR) + "%s_%s.png" % [zone, suffix]
		if not ResourceLoader.exists(path):
			continue
		var layer := Parallax2D.new()
		layer.scroll_scale = LAYERS[suffix]
		layer.repeat_size = Vector2(SIZE.x, 0)
		layer.repeat_times = 3
		layer.ignore_camera_scroll = true
		var sprite := Sprite2D.new()
		sprite.texture = load(path)
		# Painted at the render density (design bible 12.1): scale back to world pixels.
		sprite.scale = SIZE / sprite.texture.get_size()
		sprite.centered = false
		sprite.position = OFFSET
		layer.add_child(sprite)
		add_child(layer)


## Parallax2D reads the camera scroll in render pixels, which is GameCamera.DETAIL
## times too far once the camera zooms, so the layers get it in world pixels.
func _process(_delta: float) -> void:
	var t := get_viewport().get_canvas_transform()
	var offset := -t.origin / t.get_scale()
	for layer in get_children():
		(layer as Parallax2D).screen_offset = offset
